# Estas variables las crea Vercel automáticamente cuando conectas
# una base de datos Upstash Redis a tu proyecto
# (Storage → Marketplace Database Providers → Upstash → Redis).
# No las llenes a mano en producción — Vercel las inyecta solas.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Estas SÍ debes crearlas tú, en Vercel → tu proyecto → Settings → Environment Variables:
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto-por-una-clave-segura

# Tu número real de WhatsApp, con indicativo de país, sin + ni espacios:
NEXT_PUBLIC_WHATSAPP_NUMERO=573000000000
